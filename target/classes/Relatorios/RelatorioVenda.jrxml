	<queryString language="SQL"><![CDATA[SELECT vendas.preco_total,
	vendas.comissao_percentual,
	cliente.nome_completo_razao_social,
	cliente.cnpj_cpf,
	produto.produto_descricao
FROM vendas
	INNER JOIN cliente ON 
	 vendas.cliente_id = cliente.cliente_id ,
	produto]]></queryString>
